# Purpleberg Terminal Environment Variables

# Server port (default: 3001)
PORT=3001

# CORS allowlist. Comma-separated origins that are allowed to hit /api/*.
# Requests from any other origin are rejected. Default covers local dev.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Optional CoinGecko Demo API key. Lifts the public rate limit on the crypto
# screen. Without it the public tier (with a CoinPaprika fallback) is used.
# COINGECKO_API_KEY=

# Optional Finnhub API key (free tier: https://finnhub.io). Enables the LIVE
# IPO calendar on the IPO screen. Without it, the curated "Top IPOs of 2026"
# list still works (live quotes via Yahoo); only the live calendar is disabled.
# FINNHUB_API_KEY=

# The IPO screen's FX fallback uses open.er-api.com, which needs NO key.
